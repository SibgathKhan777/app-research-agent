# Composio platform key: search and page extraction run through Composio's Tavily toolkit
COMPOSIO_API_KEY=
# Tavily key, passed to the Composio toolkit per call (free tier: 1000 credits/month)
TAVILY_API_KEY=
# Groq key (free tier is fine): extraction backend for the workflow and the second-model cross-check
GROQ_API_KEY=

# Extraction model(s): a Groq model id, or cli:<name> to run through a local LLM command-line client.
# A comma list rotates models every BLOCK_SIZE apps.
MODEL_ROTATION=openai/gpt-oss-120b
# Only for cli:<name>: the client's executable, and variable-name prefixes to drop from its environment
LLM_CLI=
LLM_CLI_STRIP_ENV=
SECOND_MODEL=openai/gpt-oss-120b
